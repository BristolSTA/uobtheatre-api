# Use this file to add environment variables into the image environment
# Rename it to ".env" and it should be automatically read

# Email (requires AWS credentials)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=

# Celery (requires AWS credentials)
# ------------------------------------------------------------------------------
CELERY_QUEUE_PREFIX=

# AWS
# ------------------------------------------------------------------------------
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Turnstile
# ------------------------------------------------------------------------------
TURNSTILE_SECRET=

# Square
# ------------------------------------------------------------------------------
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=